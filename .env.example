# Owner role: used only by migrations and seeding. Owns every schema object but is
# neither superuser nor BYPASSRLS, so FORCE ROW LEVEL SECURITY applies to it too.
OWNER_DATABASE_URL=postgres://pipeline_owner:pipeline_owner@localhost:54329/pipeline
# Application role: no ownership, no BYPASSRLS; every tenant query goes through RLS.
APP_DATABASE_URL=postgres://pipeline_app:pipeline_app@localhost:54329/pipeline
